# ---------- Server ----------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Pretty logs in development; set false for JSON logs.
LOG_PRETTY=true

# ---------- GitHub App ----------
# App ID from Settings -> Developer settings -> GitHub Apps -> your app.
GITHUB_APP_ID=
# Webhook secret you configured on the GitHub App.
GITHUB_WEBHOOK_SECRET=
# Paste the PEM inline (newlines may be written as \n) or point at a file.
GITHUB_PRIVATE_KEY=
# GITHUB_PRIVATE_KEY_PATH=./github-app.private-key.pem

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=8192

# ---------- Review behaviour ----------
# Comments below this self-reported confidence are listed in the summary instead of posted inline.
REVIEW_CONFIDENCE_THRESHOLD=0.6
REVIEW_MAX_FILES=20
REVIEW_MAX_DIFF_CHARS=60000
REVIEW_MAX_FILE_PATCH_CHARS=24000
REVIEW_MAX_FINDINGS=25
REVIEW_MAX_CONCURRENCY=2
REVIEW_SKIP_DRAFTS=true
# Reviewing fork PRs runs the model and static analysis on untrusted code. Off by default.
REVIEW_REVIEW_FORKS=false
REVIEW_SUMMARY_ON_CLEAN=true
REVIEW_TRIGGER_ACTIONS=opened,reopened,synchronize,ready_for_review

# ---------- Static analysis baseline ----------
SEMGREP_ENABLED=true
# Local rules by default (no network needed). Use "auto" or "p/security-audit" for registry packs.
SEMGREP_CONFIG=./semgrep/rules.yml
SEMGREP_TIMEOUT_MS=120000
SEMGREP_MAX_FILE_BYTES=200000
