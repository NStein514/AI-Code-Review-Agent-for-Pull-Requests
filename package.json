{
  "name": "ai-code-review-agent",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub App that reviews pull requests with Claude, posts inline confidence-scored comments, and compares findings against a Semgrep baseline.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "review:diff": "tsx src/cli/review-diff.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
